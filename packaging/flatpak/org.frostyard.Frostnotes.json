{
  "app-id": "org.frostyard.Frostnotes",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "frostnotes",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "frostnotes",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/run/build/frostnotes/go-sdk/bin",
        "env": {
          "GOPROXY": "file:///run/build/frostnotes/goproxy",
          "GOSUMDB": "off",
          "GOTOOLCHAIN": "local",
          "GOFLAGS": "-trimpath -buildvcs=false -modcacherw",
          "GOMODCACHE": "/run/build/frostnotes/.gomodcache",
          "GOCACHE": "/run/build/frostnotes/.gocache",
          "CGO_ENABLED": "0"
        }
      },
      "build-commands": [
        "go build -tags mygo_noinspector -ldflags '-s -w -X main.version=flatpak -X github.com/egoist/mygo.production=1' -o build/ ./cmd/notesd ./cmd/notesctl ./cmd/frostnotes",
        "install -Dm755 -t /app/bin build/notesd build/notesctl",
        "install -Dm755 build/frostnotes /app/libexec/frostnotes-app",
        "install -Dm755 packaging/flatpak/frostnotes.sh /app/bin/frostnotes",
        "install -Dm755 packaging/flatpak/request-background.py /app/libexec/frostnotes-request-background",
        "install -Dm644 packaging/flatpak/org.frostyard.Frostnotes.desktop -t /app/share/applications",
        "install -Dm644 packaging/flatpak/org.frostyard.Frostnotes.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 packaging/icons/icon.svg /app/share/icons/hicolor/scalable/apps/org.frostyard.Frostnotes.svg",
        "install -Dm644 packaging/icons/128x128.png /app/share/icons/hicolor/128x128/apps/org.frostyard.Frostnotes.png",
        "install -Dm644 packaging/icons/icon.png /app/share/icons/hicolor/512x512/apps/org.frostyard.Frostnotes.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".github",
            ".flatpak-builder",
            ".worktrees",
            "app",
            "build",
            "dev",
            "docs",
            "flatpak_app",
            "repo"
          ]
        },
        {
          "type": "archive",
          "url": "https://dl.google.com/go/go1.27.4.linux-amd64.tar.gz",
          "sha256": "7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840",
          "dest": "go-sdk",
          "only-arches": ["x86_64"]
        },
        "go-sources.json"
      ],
      "test-commands": [
        "python3 -m py_compile packaging/flatpak/request-background.py",
        "python3 -c \"from gi.repository import Gio, GLib\"",
        "desktop-file-validate /app/share/applications/org.frostyard.Frostnotes.desktop",
        "appstreamcli validate --no-net /app/share/metainfo/org.frostyard.Frostnotes.metainfo.xml",
        "sh packaging/flatpak/smoke-test.sh"
      ]
    }
  ]
}
